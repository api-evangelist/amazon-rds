                  "value": "CreateDBCluster"
                },
                {
                  "disabled": false,
                  "key": "DBClusterIdentifier",
                  "value": "<string>",
                  "description": "(Required) The DB cluster identifier, unique for each DB cluster"
                },
                {
                  "disabled": false,
                  "key": "Engine",
                  "value": "<string>",
                  "description": "(Required) The database engine to use (aurora-mysql, aurora-postgresql)"
                },
                {
                  "disabled": false,
                  "key": "EngineVersion",
                  "value": "<string>",
                  "description": "The version number of the database engine to use"
                },
                {
                  "disabled": false,
                  "key": "MasterUsername",
