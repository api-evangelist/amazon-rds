                  "description": "The name of the master user for the DB cluster"
                },
                {
                  "disabled": false,
                  "key": "MasterUserPassword",
                  "value": "<string>",
                  "description": "The password for the master database user"
                },
                {
                  "disabled": false,
                  "key": "DatabaseName",
                  "value": "<string>",
                  "description": "The name for a database to create in the DB cluster"
                },
                {
                  "disabled": false,
                  "key": "Port",
